# SAP ERP MCP Server — Environment Variables Template
# Copy this file to .env and fill in your values.

DB_HOST=localhost
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=sap_erp
DB_POOL_SIZE=5

MCP_HOST=0.0.0.0
MCP_PORT=8000

# Set a strong random string here when exposing via ngrok (e.g. openssl rand -hex 32)
API_KEY=

ENVIRONMENT=development
LOG_LEVEL=INFO
